		{"id":"c3b9e009938","type":"text","x":1488,"y":2566,"width":330,"height":132,"text":"**[[Ньют Скамандер]]**\nУправление зверей; Бюро по переселению домовых эльфов (Pottermore)\nгоды: не указаны","color":"3"},
